# ETL Workflow Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================

# Supabase Project URL
# Format: https://[PROJECT-ID].supabase.co
# Get from: Supabase Dashboard > Settings > API > Project URL
VITE_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"

# Supabase Project ID (used in URLs)
# Get from: Project URL or Settings > General
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"

# Supabase Anon Key (Public, safe to expose in client)
# Get from: Supabase Dashboard > Settings > API > anon public
# This key has RLS restrictions and is safe for the browser
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (⚠️ KEEP SECRET - Never commit or expose in browser!)
# Get from: Supabase Dashboard > Settings > API > service_role secret
# Storage: This should NEVER be used in client-side code
# Only use in backend/server environments
VITE_SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================================
# API CONFIGURATION (Required for Functions)
# ============================================================================

# Supabase Functions API Base URL
# Format: https://[PROJECT-ID].supabase.co/functions/v1
# This is where deployed edge functions are accessed
VITE_API_BASE_URL="https://YOUR-PROJECT-ID.supabase.co/functions/v1/agent-api"

# ============================================================================
# AGENT CONFIGURATION (Optional - if using self-hosted agents)
# ============================================================================

# Agent API Endpoint
# Used by agents to communicate with the ETL workflow
VITE_AGENT_API_URL="https://YOUR-PROJECT-ID.supabase.co/functions/v1"

# Agent API Token (generated during agent setup)
# Agents use this to authenticate with the API
VITE_AGENT_API_TOKEN="your-agent-token-here"

# ============================================================================
# APPLICATION CONFIGURATION (Optional)
# ============================================================================

# Application Environment
# Values: development, staging, production
# Default: development (if not specified)
VITE_APP_ENV="development"

# Enable verbose logging
# Values: true, false
# Default: false (if not specified)
VITE_DEBUG_LOGGING="false"

# Application URL (for redirects and CORS)
# Used in authentication and agent callbacks
VITE_APP_URL="http://localhost:8080"

# ============================================================================
# INSTRUCTIONS FOR OBTAINING CREDENTIALS
# ============================================================================

# 1. CREATE SUPABASE PROJECT
#    - Go to: https://app.supabase.com
#    - Click: "New Project"
#    - Follow prompts to create project
#
# 2. RUN MIGRATION SCRIPT
#    - Open SQL Editor
#    - Paste: ETL_MIGRATION_SCRIPT.sql
#    - Execute the script
#
# 3. GET CREDENTIALS
#    - Go to: Settings > API
#    - Copy Project URL → VITE_SUPABASE_URL
#    - Copy Project ID (from URL) → VITE_SUPABASE_PROJECT_ID
#    - Copy "anon public" key → VITE_SUPABASE_PUBLISHABLE_KEY
#    
#    Optionally for backend:
#    - Copy "service_role secret" key → VITE_SUPABASE_SECRET_KEY
#      ⚠️ KEEP THIS SECRET - NEVER COMMIT OR EXPOSE!
#
# 4. UPDATE .env
#    - Fill in the VITE_SUPABASE_* variables
#    - TEST with: npm run dev
#
# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================

# ✅ DO:
#   - Fill in VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY
#   - These are safe to expose in browser (RLS protected)
#   - Use environment-specific .env files
#   - Rotate keys regularly
#   - Use strong database passwords
#   - Enable HTTPS in production
#   - Enable MFA in Supabase Authentication
#
# ❌ DON'T:
#   - Commit .env files to version control
#   - Use the service_role key in client code
#   - Share credentials via email or chat
#   - Use weak passwords
#   - Leave default database passwords
#   - Disable RLS in production
#   - Expose API tokens in URLs

# ============================================================================
# EXAMPLE COMPLETED .env
# ============================================================================

# Real example (sanitized):
# VITE_SUPABASE_URL="https://xyzabc123.supabase.co"
# VITE_SUPABASE_PROJECT_ID="xyzabc123"
# VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhzemFiYzEyMyIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzYzOTY4MDQ3LCJleHAiOjIwNzk1NDQwNDd9.HntMCQgGp7PmfryCvilswUNOvyTHuRPYdTgZGvY6z7k"
# VITE_API_BASE_URL="https://xyzabc123.supabase.co/functions/v1/agent-api"
# VITE_APP_URL="http://localhost:8080"

# ============================================================================
# VERIFICATION
# ============================================================================

# After filling in .env, verify by running:
# npm run dev
#
# Check browser console for:
# ✅ No CORS errors
# ✅ No "Failed to fetch" errors
# ✅ Supabase client successfully initialized
#
# In browser Network tab:
# ✅ Supabase API calls complete successfully
# ✅ No 401/403 errors
